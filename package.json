{
    "name": "jtsx-loader",
    "version": "0.1.18",
    "main": "./loader/register.mjs",
    "exports": {
        ".": {
            "browser": "./browser.js",
            "default": "./loader/register.mjs"
        },
        "./factory/jsxFactory.js": {
            "browser": "./browser.js",
            "default": "./factory/jsxFactory.js"
        },
        "./factory/asyncFactory.js": {
            "browser": "./browserAsync.js",
            "default": "./factory/asyncFactory.js"
        },
        "./*": "./*"
    },
    "type": "module",
    "imports": {
        "#@/*": "./*"
    },
    "scripts": {
        "test": "node --test",
        "test:compat": "node --test tests/compat.test.mjs",
        "test:package": "node scripts/check-package.mjs",
        "start": "node ./example/start.js",
        "dev": "nodemon ./example/start.js",
        "patch": "npm version patch && npm publish"
    },
    "engines": {
        "node": ">=20.16"
    },
    "keywords": [
        "jsx",
        "tsx",
        "loader",
        "html",
        "static",
        "node",
        "template engine"
    ],
    "author": "Dergachev Mihail <dergachev.mihail@gmail.com>",
    "license": "MIT",
    "description": "JSX and TSX in Node.js without React, with a shared HTML factory for server and browser",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dergachevm/jtsx-loader.git"
    },
    "dependencies": {
        "esbuild": "^0.28.1"
    },
    "devDependencies": {
        "express": "^5.2.1",
        "htmlfy": "^1.0.2",
        "nodemon": "^3.1.14",
        "shiki": "4.5.0"
    }
}
