{
    "name": "jtsx-loader",
    "version": "0.2.0",
    "main": "./loader/register.mjs",
    "exports": {
        ".": {
            "browser": "./browser.js",
            "default": "./loader/register.mjs"
        },
        "./factory/jsxFactory.js": {
            "browser": "./browser.js",
            "default": "./factory/jsxFactory.js"
        },
        "./factory/asyncFactory.js": {
            "browser": "./browserAsync.js",
            "default": "./factory/asyncFactory.js"
        },
        "./*": "./*"
    },
    "type": "module",
    "scripts": {
        "test": "node --test",
        "test:compat": "node --test tests/compat.test.mjs",
        "test:package": "node scripts/check-package.mjs",
        "bump": "npm version minor --no-git-tag-version",
        "patch": "npm version patch --no-git-tag-version"
    },
    "engines": {
        "node": ">=20.16"
    },
    "keywords": [
        "jsx",
        "tsx",
        "loader",
        "html",
        "static",
        "node",
        "template engine"
    ],
    "author": "Dergachev Mihail <dergachev.mihail@gmail.com>",
    "license": "MIT",
    "description": "JSX and TSX in Node.js without React, with a shared HTML factory for server and browser",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dergachevm/jtsx-loader.git"
    },
    "dependencies": {
        "esbuild": "^0.28.1"
    },
    "files": [
        "loader/",
        "factory/",
        "browser.js",
        "browserAsync.js",
        "register.js",
        "runtime.js",
        "jtsx.config.example.js",
        "README.md",
        "CHANGELOG.md"
    ]
}
